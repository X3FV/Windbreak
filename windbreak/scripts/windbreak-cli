#!/usr/bin/env bash
#
# `windbreak-cli` — run the scan/pipeline CLI with the target as the working directory.
#
#   scripts/windbreak-cli scan --static-only
#   scripts/windbreak-cli recon
#   WINDBREAK_TARGET=/some/other/repo scripts/windbreak-cli toctou
#
# Why this is short, and why it does not pass `--target` for you: the CLI reads
# `<cwd>/.windbreak/config.json` at startup (`config.discoverConfigPath`) and its state
# database default is already `<cwd>/.windbreak/state.db`. Running *from* the target is
# the whole mechanism — the default target, the state database, the scratch directories
# and the reports all land in that one folder, and nothing here needs to know which
# subcommands accept `--target`. Pass `--target` or `--db` yourself and they win, because
# an explicit option always beats a default.
#
# The target is `$WINDBREAK_TARGET`, else the checkout this package is part of.
#
# Install — a symlink, not a copy:
#   ln -sf "$PWD/scripts/windbreak-cli" ~/.local/bin/windbreak-cli
#
# A copy works too, but then this script has no way back to its own checkout, so it needs
# `WINDBREAK_ROOT=<checkout>` exported. The symlink is the better default here: editing
# the CLI takes effect on the next run, with no reinstall step to forget.
#
# Name note: `scripts/windbreak` next to this file is a *different* entry point — the
# adjudication screen inside the freebuff TUI, dispatched by `freebuff windbreak`, and
# `scripts/windbreak-tui` is that same screen run from this checkout. This one is the
# standalone scan surface (`src/index.ts`), which is what `package.json`'s `windbreak`
# bin exposes.
set -euo pipefail

# Where this script really lives, following symlinks — `dirname "${BASH_SOURCE[0]}"` alone
# would report `~/.local/bin` for an installed link and land the package dir on `~/.local`.
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *) script_path="$(dirname "$script_path")/$link_target" ;;
  esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"

# The checkout to run. `scripts/` is one level under the package and two under the
# repository root, so the in-place case can find it unaided; an installed copy cannot, and
# says so rather than guessing.
if [ -n "${WINDBREAK_ROOT:-}" ]; then
  repo_root="$(cd "$WINDBREAK_ROOT" && pwd)"
elif [ -f "$script_dir/../src/index.ts" ]; then
  repo_root="$(cd "$script_dir/../.." && pwd)"
else
  printf 'windbreak-cli: cannot tell which checkout to run.\n' >&2
  printf 'windbreak-cli: set WINDBREAK_ROOT to the repository that holds windbreak/.\n' >&2
  exit 1
fi

package_dir="$repo_root/windbreak"
if [ ! -f "$package_dir/src/index.ts" ]; then
  printf 'windbreak-cli: no CLI at %s.\n' "$package_dir/src/index.ts" >&2
  printf 'windbreak-cli: set WINDBREAK_ROOT to the repository that holds windbreak/.\n' >&2
  exit 1
fi

target="${WINDBREAK_TARGET:-$repo_root}"
if [ ! -d "$target" ]; then
  printf 'windbreak-cli: target directory does not exist: %s\n' "$target" >&2
  printf 'windbreak-cli: set WINDBREAK_TARGET to the checkout you want to scan.\n' >&2
  exit 1
fi

# bun, in bun's own order: `$BUN`, then PATH, then the directory the official installer
# writes to. The last lookup is what lets this run from a shell whose PATH was set *before*
# bun was installed — an open terminal never re-reads `~/.bashrc`, and "this shell cannot
# find bun" is not the same finding as "this machine has no bun".
bun_bin=""
for candidate in "${BUN:-}" bun "${BUN_INSTALL:-$HOME/.bun}/bin/bun"; do
  if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
    bun_bin="$candidate"
    break
  fi
done

if [ -z "$bun_bin" ]; then
  printf 'windbreak-cli: no bun on PATH, in $BUN, or at %s.\n' "${BUN_INSTALL:-$HOME/.bun}/bin/bun" >&2
  printf 'windbreak-cli: windbreak needs bun 1.3.x. `curl -fsSL https://bun.sh/install | bash -s bun-v1.3.14`\n' >&2
  printf 'windbreak-cli: installs it; a shell already open will not see it until it is restarted,\n' >&2
  printf 'windbreak-cli: or set BUN=/path/to/bun if it is installed somewhere else.\n' >&2
  exit 127
fi

cd "$target"

# On stderr, so a `--json` run's stdout stays parseable.
printf 'windbreak-cli: target %s\n' "$target" >&2

exec "$bun_bin" "$package_dir/src/index.ts" "$@"
