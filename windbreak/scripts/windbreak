#!/usr/bin/env bash
#
# `windbreak` — open the adjudication screen from any directory.
#
# The screen itself lives in the freebuff CLI (`freebuff windbreak`, spec D32 /
# §5.3). This is a dispatcher and nothing more: `--db` and `--cwd` are forwarded
# untouched so a caller that names what it wants gets it.
#
# Why it no longer walks up to a `.windbreak/state.db` of its own. It used to,
# because the screen resolved its default database as `./.windbreak/state.db` —
# relative to the *current* directory — while resolving the repository it shows by
# walking up to `.git`. From a subdirectory those two disagreed, so the wrapper
# patched the database half in bash, and passed its guess as `--db`.
#
# The screen now resolves the database itself (cli/src/windbreak/database.ts), from
# the same repository root it already resolves, and it knows about the checkout's own
# `.windbreak/config.json` — which the bash walk-up could not read, and which is why a
# configured `"db"` used to be overridden by this script's guess. Two implementations
# of one resolution was the bug; this is the one that went away.
#
# Install:
#   install -m 755 scripts/windbreak ~/.local/bin/windbreak
#
# Note the name overlap: `package.json` also declares a `windbreak` bin, which is
# the standalone scan/pipeline CLI (`src/index.ts`). This script is deliberately
# not that — from a PATH named `windbreak` you get the TUI; the scan surface is
# still `bun run src/index.ts …` from the checkout.

if ! command -v freebuff >/dev/null 2>&1; then
  printf 'windbreak: needs `freebuff` on PATH — the adjudication screen ships inside it.\n' >&2
  printf 'windbreak: install the freebuff CLI, or run `freebuff windbreak` from a build.\n' >&2
  exit 127
fi

exec freebuff windbreak "$@"
