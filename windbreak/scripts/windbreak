#!/usr/bin/env bash
#
# `windbreak` — open the adjudication screen from any directory.
#
# The screen itself lives in the freebuff CLI (`freebuff windbreak`, spec D32 /
# §5.3). This is only a dispatcher, because that surface resolves its default
# database as `./.windbreak/state.db` — relative to the *current* directory — so
# running it from a subdirectory of a scanned project would look for a queue in
# the wrong place. When the caller names no database, this walks up to the
# nearest `.windbreak/state.db` the way git finds `.git`, and passes it
# explicitly. `--db` and `--cwd` are left alone: those are how a caller says
# which database it wants, and a caller that says gets it.
#
# Install:
#   install -m 755 scripts/windbreak ~/.local/bin/windbreak
#
# Note the name overlap: `package.json` also declares a `windbreak` bin, which is
# the standalone scan/pipeline CLI (`src/index.ts`). This script is deliberately
# not that — from a PATH named `windbreak` you get the TUI; the scan surface is
# still `bun run src/index.ts …` from the checkout.

DB_RELATIVE='.windbreak/state.db'

if ! command -v freebuff >/dev/null 2>&1; then
  printf 'windbreak: needs `freebuff` on PATH — the adjudication screen ships inside it.\n' >&2
  printf 'windbreak: install the freebuff CLI, or run `freebuff windbreak` from a build.\n' >&2
  exit 127
fi

args=("$@")

caller_chose_db=0
for arg in "$@"; do
  case "$arg" in
    --db | --db=* | --cwd | --cwd=*) caller_chose_db=1 ;;
  esac
done

if [ "$caller_chose_db" -eq 0 ]; then
  dir="$PWD"
  while :; do
    if [ -f "$dir/$DB_RELATIVE" ]; then
      args+=("--db" "$dir/$DB_RELATIVE")
      break
    fi
    parent=$(dirname "$dir")
    # `dirname /` is `/`; that is the stop condition.
    if [ "$parent" = "$dir" ]; then
      break
    fi
    dir="$parent"
  done
fi

exec freebuff windbreak "${args[@]}"
